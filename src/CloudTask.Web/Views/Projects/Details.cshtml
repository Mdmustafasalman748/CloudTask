@model CloudTask.Web.Controllers.ProjectDetailsViewModel
@{
    ViewData["Title"] = Model.Project.Name;
}

<h1 class="h3">@Model.Project.Name</h1>
<p class="text-muted">@Model.Project.Description</p>

@if (TempData["Error"] is string error)
{
<div class="alert alert-danger">@error</div>
}

@if (!Model.TasksVisible)
{
<div class="alert alert-info">Only the project owner can view and manage its tasks.</div>
}
else
{
<form asp-action="AddTask" asp-route-id="@Model.Project.Id" method="post" class="row g-2 mb-4">
    <div class="col-md-6">
        <input name="title" class="form-control" placeholder="New task title" required maxlength="200" />
    </div>
    <div class="col-md-3">
        <select name="priority" class="form-select">
            <option>Low</option>
            <option selected>Medium</option>
            <option>High</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Add task</button>
    </div>
</form>

if (!Model.Tasks.Any())
    {
<p>No tasks yet.</p>
    }
    else
    {
<table class="table align-middle">
    <thead>
        <tr><th>Title</th><th>Priority</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var t in Model.Tasks)
            {
        <tr>
            <td>@t.Title</td>
            <td>@t.Priority</td>
            <td>@t.Status</td>
            <td>
                @if (t.Status == "Todo")
                        {
                <form asp-action="TaskAction" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Project.Id" />
                    <input type="hidden" name="taskId" value="@t.Id" />
                    <input type="hidden" name="action" value="start" />
                    <button class="btn btn-sm btn-outline-primary">Start</button>
                </form>
                        }
                @if (t.Status != "Done")
                        {
                <form asp-action="TaskAction" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Project.Id" />
                    <input type="hidden" name="taskId" value="@t.Id" />
                    <input type="hidden" name="action" value="complete" />
                    <button class="btn btn-sm btn-outline-success">Complete</button>
                </form>
                        }
            </td>
        </tr>
            }
    </tbody>
</table>
    }
}

<a asp-controller="Home" asp-action="Index">Back to projects</a>