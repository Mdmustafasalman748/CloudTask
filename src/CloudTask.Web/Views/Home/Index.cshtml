@model CloudTask.Web.Models.PagedDto<CloudTask.Web.Models.ProjectDto>
    @{
    ViewData["Title"] = "Projects";
    }

    <h1 class="h3 mb-3">Welcome, @User.Identity?.Name</h1>
    <p class="text-muted">@Model.TotalCount project(s)</p>

    <a asp-controller="Projects" asp-action="Create" class="btn btn-primary mb-3">New project</a>

    @if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

    @if (!Model.Items.Any())
{
    <p>No projects yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Name</th><th>Description</th><th>Tasks</th></tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Items)
        {
            <tr>
                <td><a asp-controller="Projects" asp-action="Details" asp-route-id="@p.Id">@p.Name</a></td>
                <td>@p.Description</td>
                <td>@p.TaskCount</td>
            </tr>
        }
        </tbody>
    </table>
}

    @if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
